# --- Zitadel (identity provider) ---
ZITADEL_VERSION=v4.17.2
ZITADEL_PORT=8888
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters
ZITADEL_INSTANCE_NAME=ERP
ZITADEL_ORG_NAME=Acme Corp
ZITADEL_ADMIN_USERNAME=zitadel-admin
ZITADEL_ADMIN_EMAIL=admin@acme.local
ZITADEL_ADMIN_PASSWORD=Password1!

# --- Spike API server ---
APP_PORT=7777
APP_BASE_URL=http://localhost:7777
APP_SECRET=$(openssl rand -hex 32)

# Filled by scripts/provision.sh into .env.local (git-ignored)
# OIDC_ISSUER / OIDC_CLIENT_ID / OIDC_CLIENT_SECRET(empty for PKCE) / OIDC_REDIRECT_URI
